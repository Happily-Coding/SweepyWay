                function r_cover_case_fn() {
                    

                // creating part 0 of case r_cover
                let r_cover__part_0 = r_coverpart_switch_plate_outline_extrude_1_2_outline_fn();

                // make sure that rotations are relative
                let r_cover__part_0_bounds = r_cover__part_0.getBounds();
                let r_cover__part_0_x = r_cover__part_0_bounds[0].x + (r_cover__part_0_bounds[1].x - r_cover__part_0_bounds[0].x) / 2
                let r_cover__part_0_y = r_cover__part_0_bounds[0].y + (r_cover__part_0_bounds[1].y - r_cover__part_0_bounds[0].y) / 2
                r_cover__part_0 = translate([-r_cover__part_0_x, -r_cover__part_0_y, 0], r_cover__part_0);
                r_cover__part_0 = rotate([0,0,0], r_cover__part_0);
                r_cover__part_0 = translate([r_cover__part_0_x, r_cover__part_0_y, 0], r_cover__part_0);

                r_cover__part_0 = translate([0,0,25], r_cover__part_0);
                let result = r_cover__part_0;
                
            

                // creating part 1 of case r_cover
                let r_cover__part_1 = r_controller_area_to_cover_outline_extrude_5_outline_fn();

                // make sure that rotations are relative
                let r_cover__part_1_bounds = r_cover__part_1.getBounds();
                let r_cover__part_1_x = r_cover__part_1_bounds[0].x + (r_cover__part_1_bounds[1].x - r_cover__part_1_bounds[0].x) / 2
                let r_cover__part_1_y = r_cover__part_1_bounds[0].y + (r_cover__part_1_bounds[1].y - r_cover__part_1_bounds[0].y) / 2
                r_cover__part_1 = translate([-r_cover__part_1_x, -r_cover__part_1_y, 0], r_cover__part_1);
                r_cover__part_1 = rotate([0,0,0], r_cover__part_1);
                r_cover__part_1 = translate([r_cover__part_1_x, r_cover__part_1_y, 0], r_cover__part_1);

                r_cover__part_1 = translate([0,0,25], r_cover__part_1);
                result = result.union(r_cover__part_1);
                
            

                // creating part 2 of case r_cover
                let r_cover__part_2 = r_controler_area_to_not_fill_extrude_5_outline_fn();

                // make sure that rotations are relative
                let r_cover__part_2_bounds = r_cover__part_2.getBounds();
                let r_cover__part_2_x = r_cover__part_2_bounds[0].x + (r_cover__part_2_bounds[1].x - r_cover__part_2_bounds[0].x) / 2
                let r_cover__part_2_y = r_cover__part_2_bounds[0].y + (r_cover__part_2_bounds[1].y - r_cover__part_2_bounds[0].y) / 2
                r_cover__part_2 = translate([-r_cover__part_2_x, -r_cover__part_2_y, 0], r_cover__part_2);
                r_cover__part_2 = rotate([0,0,0], r_cover__part_2);
                r_cover__part_2 = translate([r_cover__part_2_x, r_cover__part_2_y, 0], r_cover__part_2);

                r_cover__part_2 = translate([0,0,25], r_cover__part_2);
                result = result.subtract(r_cover__part_2);
                
            

                // creating part 3 of case r_cover
                let r_cover__part_3 = r_controller_area_to_cover_outline_extrude_2_outline_fn();

                // make sure that rotations are relative
                let r_cover__part_3_bounds = r_cover__part_3.getBounds();
                let r_cover__part_3_x = r_cover__part_3_bounds[0].x + (r_cover__part_3_bounds[1].x - r_cover__part_3_bounds[0].x) / 2
                let r_cover__part_3_y = r_cover__part_3_bounds[0].y + (r_cover__part_3_bounds[1].y - r_cover__part_3_bounds[0].y) / 2
                r_cover__part_3 = translate([-r_cover__part_3_x, -r_cover__part_3_y, 0], r_cover__part_3);
                r_cover__part_3 = rotate([0,0,0], r_cover__part_3);
                r_cover__part_3 = translate([r_cover__part_3_x, r_cover__part_3_y, 0], r_cover__part_3);

                r_cover__part_3 = translate([0,0,30], r_cover__part_3);
                result = result.union(r_cover__part_3);
                
            
                    return result;
                }
            
            
        
            function main() {
                return r_cover_case_fn();
            }

        