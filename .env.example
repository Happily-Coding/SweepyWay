# Environment variables needed for local KiCad / KiBot / 3D-export runs.
# Copy to .env and adjust the path. Both variables must point to the SAME folder:
#   - PATH_TO_SWEEPYWAY_COMPONENT_MODELS is what the generated .kicad_pcb files reference
#   - KICAD9_3DMODEL_DIR is what KiCad 9 itself uses to resolve models
# If only one is set, the PCB renders without components (see latest-3d-model-issues.md).

# Windows / PowerShell:
#   $env:PATH_TO_SWEEPYWAY_COMPONENT_MODELS = "C:\a\IRL Products\Keyboard design\SweepyWay\component_3d_models"
#   $env:KICAD9_3DMODEL_DIR               = "C:\a\IRL Products\Keyboard design\SweepyWay\component_3d_models"
# Linux / WSL / CI:
PATH_TO_SWEEPYWAY_COMPONENT_MODELS=./component_3d_models
KICAD9_3DMODEL_DIR=./component_3d_models

# Optional: where KiBot finds the KiCad user config inside containers (CI sets this itself)
# KICAD_CONFIG_HOME=./kicad-config
